            font-size: 22px;
            color: #2c3e50;
            text-transform: uppercase;
            letter-spacing: 1px;
            margin-bottom: 5px;
        }
        .header p {
            font-size: 13px;
            color: #7f8c8d;
            font-style: italic;
        }

        /* Section Titles */
        .section-title {
            font-size: 14px;
            font-weight: bold;
            color: #2c3e50;
            margin-bottom: 10px;
            display: flex;
            align-items: center;
            gap: 6px;
        }

        /* Info Umum Kelas Table */
        .info-table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 25px;
            font-size: 13px;
        }
        .info-table th, .info-table td {
            border: 1px solid #cbd5e1;
            padding: 8px 12px;
            text-align: left;
        }
        .info-table th {
            width: 25%;
            background-color: #f1f5f9;
            color: #334155;
        }
        .info-table td {
            width: 75%;
            background-color: #ffffff;
        }

        /* Daftar Anggota */
        .member-list {
            background-color: #f8fafc;
            border: 1px solid #e2e8f0;
            padding: 15px 20px;
            border-radius: 6px;
            margin-bottom: 30px;
            font-size: 13px;
        }
        .member-list ol {
            padding-left: 20px;
        }
        .member-list li {
            margin-bottom: 4px;
        }
        .member-list a {
            color: #2563eb;
            text-decoration: none;
        }
        .member-list a:hover {
            text-decoration: underline;
        }

        /* Profil Siswa Card */
        .student-card {
            border: 1px solid #cbd5e1;
            border-radius: 6px;
            margin-bottom: 10px;
            background: #fff;
            overflow: hidden;
        }
        .student-card-header {
            background-color: #f1f5f9;
            padding: 10px 15px;
            font-size: 13px;
            font-weight: bold;
            color: #1e293b;
            border-bottom: 1px solid #cbd5e1;
            display: flex;
            align-items: center;
            gap: 8px;
        }
        .student-card-body {
            display: flex;
            padding: 20px;
            gap: 20px;
        }
        .student-photo-col {
            width: 35%;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
        }
        .photo-box {
            width: 140px;
            height: 180px;
            border: 2px solid #cbd5e1;
            background-color: #f8fafc;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
            margin-bottom: 12px;
            border-radius: 4px;
        }
        .photo-box img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }
        .audio-player {
            width: 100%;
            font-size: 11px;
            color: #475569;
            text-align: center;
        }
        .audio-player audio {
            width: 100%;
            height: 30px;
            margin-top: 4px;
        }
        .student-info-col {
            width: 65%;
            font-size: 13px;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }
        .student-details {
            list-style: none;
        }
        .student-details li {
            margin-bottom: 8px;
            position: relative;
            padding-left: 15px;
        }
        .student-details li::before {
            content: "•";
            position: absolute;
            left: 0;
            color: #0f172a;
            font-weight: bold;
        }
        .link-history {
            margin-top: 15px;
            padding-top: 10px;
            border-top: 1px dashed #e2e8f0;
            font-size: 13px;
